NODE_ENV=development

# Task-management service HTTP port. The gateway is the public front door and
# proxies to it. In docker-compose the gateway listens on 3000 and task-management
# on 3001; for local dev run task-management with PORT=3001, the gateway on 3000.
PORT=3001

# Gateway (apps/gateway) -> upstream services. The extracted services match
# first; /auth + /invitations -> identity, /notifications -> notifications, the
# rest -> task-management.
TASK_MANAGEMENT_URL=http://localhost:3001
IDENTITY_URL=http://localhost:3003
NOTIFICATIONS_URL=http://localhost:3002

# MongoDB — one Mongo container per service (database-per-service):
#   task-management -> `mongo-task-management` (task_management DB, host :27017)
#   identity        -> `mongo-identity`        (identity DB,        host :27019)
#   notifications   -> `mongo-notifications`   (notifications DB,   host :27018)
# In docker-compose each service sets its own MONGO_URI; the value below is the
# task-management one (for local dev). Point identity/notifications at their own
# DBs, e.g. mongodb://admin:admin@localhost:27019/identity?authSource=admin.
MONGO_URI=mongodb://admin:admin@localhost:27017/task_management?authSource=admin

# Kafka (comma-separated host:port list)
KAFKA_BROKERS=localhost:9092

# Swagger
SWAGGER_PATH=docs

# Auth
JWT_SECRET=w9Xk$2!pL7&mZv@qR1!4yJ8vB5!3x%T0
JWT_EXPIRES_IN=1d

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin!1234

# Mail (Mailhog locally; SMTP_HOST=mailhog inside docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tmp.local
APP_BASE_URL=http://localhost:4200

# Shared secret the task-management service presents on Identity's internal
# /internal/* API (service-to-service user lookups).
INTERNAL_API_KEY=dev-internal-key
