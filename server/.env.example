NODE_ENV=development

# Monolith HTTP port. The gateway is the public front door and proxies to it.
# In docker-compose the gateway listens on 3000 and the monolith on 3001;
# for local dev run the monolith with PORT=3001 and the gateway on 3000.
PORT=3001

# Gateway (apps/gateway) -> upstream services. Carved-out services match first
# (Phase 1: /notifications/* -> notifications service); the rest -> monolith.
MONOLITH_URL=http://localhost:3001
NOTIFICATIONS_URL=http://localhost:3002

# MongoDB — one Mongo container per service (database-per-service). The monolith
# uses the `mongo` container (task_management DB, host :27017); the notifications
# service uses its own `mongo-notifications` container (notifications DB, host
# :27018). In docker-compose each service sets its own MONGO_URI; for local dev,
# run the notifications app with PORT=3002 and
# MONGO_URI=mongodb://admin:admin@localhost:27018/notifications?authSource=admin.
MONGO_URI=mongodb://admin:admin@localhost:27017/task_management?authSource=admin

# Kafka (comma-separated host:port list)
KAFKA_BROKERS=localhost:9092

# Swagger
SWAGGER_PATH=docs

# Auth
JWT_SECRET=w9Xk$2!pL7&mZv@qR1!4yJ8vB5!3x%T0
JWT_EXPIRES_IN=1d

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin!1234

# Mail (Mailhog locally; SMTP_HOST=mailhog inside docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tmp.local
APP_BASE_URL=http://localhost:4200
