# MongoDB
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_DB=task_management

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Mailhog (local SMTP capture)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAIL_FROM=no-reply@tmp.local

# NestJS server
SERVER_PORT=3000
SWAGGER_PATH=docs

# Angular client
CLIENT_PORT=4200
APP_BASE_URL=http://localhost:4200
